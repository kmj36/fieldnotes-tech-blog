# Frontend
VITE_APP_NAME=FieldNotes
VITE_MODE=production #production, test
VITE_API_BASE_URL =http://localhost:8080

# Backend
API_MODE=debug # debug, release, test
API_ALLOW_ORIGINS=*
API_ADDR=0.0.0.0
API_PORT=8080
